// storage.rules
//
// Mismo principio que Firestore, pero acá `userId` no es un campo de un
// documento — es un segmento de la RUTA del archivo (recordá que subimos
// los PDFs a "recibos/{userId}/archivo.pdf"). Por eso la regla compara el
// uid del usuario contra ese pedazo de la ruta directamente.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /recibos/{userId}/{archivo} {

      // Un usuario autenticado solo puede leer y escribir DENTRO de su
      // propia carpeta ("recibos/SU_PROPIO_UID/..."), nunca en la de otro.
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
